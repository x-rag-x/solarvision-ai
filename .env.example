# ==============================================================================
# SolarVision AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# --- Server & Runtime Configuration ---
PORT=3000
NODE_ENV=development

# --- Python Environment & Inference Bridge ---
# Specify path to the Python virtual environment executable:
# Windows: backend\.venv\Scripts\python.exe
# POSIX:   backend/.venv/bin/python
PYTHON_EXECUTABLE=backend/.venv/Scripts/python.exe

# --- Model 1: Solar-Cell EL/NIR Defect Detection (YOLO26n) ---
# Primary evaluated computer vision checkpoint on solar-cell EL/NIR test images
MODEL_PATH=backend/models/best.pt
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640

# --- Model 2: Multimodal Root Cause Analysis ---
# Multimodal software prototype: operates in data-readiness / expert-review mode.
# Genuine factory training is quarantined (DATASET_INCOMPLETE) pending verified IoT sensor-defect pairs.
MODEL2_FEATURE_SPEC_PATH=backend/root_cause_data/artifacts/canonical_feature_specification_v2.json

# --- Model 3: Predictive Quality Analysis ---
# Evaluated on UCI SECOM Semiconductor Wafer Benchmark (CC-BY 4.0, DOI: 10.24432/C57G69)
# NOTE: General semiconductor benchmark; NOT trained on solar cell manufacturing lines.
MODEL3_ARTIFACT_PATH=backend/training/predictive_quality/artifacts/model3_predictive_quality.json

# --- Model 4: Predictive Maintenance ---
# Evaluated on UCI AI4I 2020 Synthetic Milling Machine Benchmark (CC-BY 4.0, DOI: 10.24432/C5HS5C)
# NOTE: Synthetic physical milling simulation; NOT certified for solar factory machinery.
MODEL4_ARTIFACT_PATH=backend/training/predictive_maintenance/artifacts/model4_predictive_maintenance.json

# --- Database Persistence Layer ---
# Default zero-dependency storage: Local SQLite database.
# If DATABASE_URL is not set, SQLite automatically stores records at data/solarvision.db.
SQLITE_DB_PATH=data/solarvision.db
UPLOADS_DIR=data/uploads

# Optional Production Database (MySQL / TiDB / PostgreSQL via Drizzle ORM):
# DATABASE_URL=mysql://user:password@localhost:3306/solarvision
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# --- Authentication & Session Security ---
# Secret key used for signing JWT session cookies (minimum 32 characters recommended)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars!

# Optional SSO OAuth Configuration (Manus OAuth):
# Leave empty for local development / test mode
OAUTH_SERVER_URL=
VITE_APP_ID=solarvision-ai
OWNER_OPEN_ID=

# --- Optional Cloud Object Storage (Supabase Storage) ---
# If omitted, inspections use local filesystem storage in data/uploads
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=solarvision-images
